# Copy this file to ".env" and fill in your AWS credentials to enable
# Amazon Comprehend (NLP) and Amazon Bedrock (Generative AI).
# Without credentials the app runs in offline mode and still works.
#
# AWS Academy Learner Lab: Start Lab -> AWS Details -> "AWS CLI: Show" and copy the 3 values.

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1

# Any Bedrock text model your account has access to, e.g.
#   amazon.nova-lite-v1:0   amazon.nova-micro-v1:0   anthropic.claude-3-haiku-20240307-v1:0
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0

# Set to "off" to force offline mode (useful if the network is slow during a demo)
USE_AWS=auto
